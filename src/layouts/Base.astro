---
import '../styles/global.css';
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? (title.includes('DeveX Tools') ? title : `${title} — DeveX Tools`) : 'DeveX Tools — Developer Tool Guides & Comparisons'}</title>
    <meta name="description" content={description || 'A curated directory of developer tools — IDEs, CI/CD platforms, Git tools, API tools, and more. Compiled from official documentation and public data.'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="site-logo"><span>DeveX</span> Tools</a>
        <nav class="main-nav">
          <a href="/" class="active">Home</a>
          <a href="/tools">Tools</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>&copy; {new Date().getFullYear()} DeveX Tools. Curated developer tool guides & comparisons.</span>
        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/disclosure">Disclosure</a>
        </div>
      </div>
    </footer>

    <div id="cookie-banner" style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999; background: var(--bg-subtle); border-top: 1px solid var(--border); padding: 14px 22px; display: none; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; font-size: 0.875rem; color: var(--text-secondary); box-shadow: 0 -2px 12px rgba(0,0,0,0.15);">
      <span style="line-height: 1.5;">We use cookies for site functionality and security. By continuing to browse, you agree to our use of cookies. See our <a href="/privacy" style="color: var(--accent); text-decoration: underline;">Privacy Policy</a>.</span>
      <button id="cookie-accept" style="background: var(--accent); color: #fff; border: none; padding: 9px 20px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.875rem; white-space: nowrap;">Accept</button>
    </div>
    <script is:inline>
      (function () {
        var banner = document.getElementById('cookie-banner');
        if (!banner) return;
        if (localStorage.getItem('cookie-consent') !== 'accepted') {
          banner.style.display = 'flex';
        }
        var accept = document.getElementById('cookie-accept');
        if (accept) {
          accept.addEventListener('click', function () {
            localStorage.setItem('cookie-consent', 'accepted');
            banner.style.display = 'none';
          });
        }
      })();
    </script>
  </body>
</html>
