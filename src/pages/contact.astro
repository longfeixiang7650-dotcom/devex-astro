---
import Base from '../layouts/Base.astro';
---

<Base title="Contact Us" description="Get in touch with the DeveX Tools team. Contact us for tool suggestions, corrections, or partnership inquiries.">
  <main class="min-h-screen py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold mb-8">Contact Us</h1>
      
      <div class="prose prose-lg max-w-none">
        <p class="text-xl text-muted-foreground mb-8">
          Have a question, suggestion, or tool recommendation? We'd love to hear from you.
        </p>

        <div class="bg-card border rounded-lg p-8 mb-8">
          <h2 class="text-2xl font-semibold mb-4">Get in Touch</h2>
          
          <div class="space-y-4">
            <div>
              <h3 class="font-medium text-lg">Email</h3>
              <p class="text-muted-foreground">
                <a href="mailto:info@devex-tools.net" class="text-primary hover:underline">info@devex-tools.net</a>
              </p>
            </div>

            <div>
              <h3 class="font-medium text-lg">Tool Submissions</h3>
              <p class="text-muted-foreground">
                Know a developer tool we should review? Send us the details and we'll add it to our evaluation queue.
              </p>
            </div>

            <div>
              <h3 class="font-medium text-lg">Advertising & Partnerships</h3>
              <p class="text-muted-foreground">
                For advertising inquiries, please review our <a href="/disclosure" class="text-primary hover:underline">Disclosure</a> page first. We do not accept sponsored reviews.
              </p>
            </div>

            <div>
              <h3 class="font-medium text-lg">Corrections</h3>
              <p class="text-muted-foreground">
                Spot an error in one of our reviews? We appreciate corrections — email us and we'll update promptly.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-muted border rounded-lg p-8">
          <h2 class="text-2xl font-semibold mb-4">Response Time</h2>
          <p class="text-muted-foreground">
            We typically respond within 1-2 business days. For urgent matters, please include "[Urgent]" in your subject line.
          </p>
        </div>
      </div>
    </div>
  </main>
</Base>
