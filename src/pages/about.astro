---
import Base from '../layouts/Base.astro';
---

<Base title="About — DeveX Tools" description="About DeveX Tools — a curated developer tool directory maintained by Long Feixiang, compiled with AI assistance from official documentation.">
  <div class="container" style="padding-top: 32px; max-width: 740px; margin: 40px auto;">
    <h1 class="page-title">About DeveX Tools</h1>

    <section style="margin: 32px 0;">
      <div style="display: flex; gap: 20px; align-items: center; padding: 20px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-subtle);">
        <img src="/avatar.png" alt="DeveX Tools logo" style="width: 88px; height: 88px; border-radius: 16px; flex-shrink: 0;" />
        <div>
          <div style="font-size: 1.15rem; font-weight: 700;">Long Feixiang (龙飞翔)</div>
          <div style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 2px;">Founder &amp; maintainer of DeveX Tools</div>
          <div style="font-size: 0.85rem; margin-top: 6px;">
            <a href="https://github.com/longfeixiang7650-dotcom" target="_blank" rel="noopener" style="color: var(--accent);">github.com/longfeixiang7650-dotcom</a>
            <span style="color: var(--text-muted);"> &middot; Jinan, Shandong, China</span>
          </div>
        </div>
      </div>
    </section>

    <section style="margin: 32px 0;">
      <p style="font-size: 1.05rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        <strong>DeveX Tools</strong> is a curated directory of developer tools — IDEs, CI/CD platforms,
        version control systems, API tools, databases, and more. Our goal is simple: give developers a
        clear, organized way to compare tools and understand what each one actually does.
      </p>
      <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        Every entry on this site is compiled from official documentation, vendor-published information,
        and publicly available data — then organized into clear feature lists, pricing details, and
        comparisons. We use AI assistance to research and draft listings, and we check the output
        against each tool's own documentation before publishing.
      </p>
      <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        The site is maintained by <strong>Long Feixiang</strong>, based in Jinan, Shandong, China.
        We don't fabricate author bylines, and we don't publish scores, ratings, or personal
        "hands-on" experiences we can't verify. When we present a feature, a price, or a license,
        it comes from the tool's own documentation or public records at the time of writing.
      </p>
    </section>

    <section style="margin: 32px 0;">
      <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px;">Our Editorial Principles</h2>
      <ul style="color: var(--text-secondary); line-height: 1.7; padding-left: 20px;">
        <li style="margin-bottom: 4px;"><strong>No sponsored placements.</strong> Zero. Tools earn their spot based on merit, not marketing budget.</li>
        <li style="margin-bottom: 4px;"><strong>Verifiable information.</strong> Feature lists, pricing, and licensing details are sourced from official documentation and public data — not invented.</li>
        <li style="margin-bottom: 4px;"><strong>No fabricated scores.</strong> We don't assign star ratings we can't justify. Instead, we give you the facts — features, pricing, and tradeoffs — so you can decide for yourself.</li>
        <li style="margin-bottom: 4px;"><strong>Living references.</strong> We update entries as tools evolve. Since launching in 2026, we regularly refresh listings as new versions and features ship.</li>
      </ul>
    </section>

    <section style="margin: 32px 0;">
      <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px;">Contact</h2>
      <p style="font-size: 0.9375rem; color: var(--text-secondary);">
        Questions, suggestions, or tool recommendations?
        Reach out at <a href="mailto:info@devex-tools.net">info@devex-tools.net</a>.
      </p>
    </section>
  </div>
</Base>
